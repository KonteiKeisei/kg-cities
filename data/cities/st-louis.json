  {
   "id": "pack:forest-park",
   "name": "Forest Park",
   "lat": 38.638192,
   "lon": -90.284703,
   "glow": true,
   "summary": "The 1,300-acre park of the 1904 World's Fair, larger than Central Park, with the zoo, the art museum and the Muny outdoor theatre. Families come for the free museums."
  },
  {
   "id": "pack:saint-louis-art-museum",
   "name": "Saint Louis Art Museum",
   "lat": 38.639468,
   "lon": -90.294403,
   "glow": true,
   "summary": "Cass Gilbert's Palace of Fine Arts from the 1904 World's Fair, on Art Hill in Forest Park. Sledders take over the hill in winter."
  },
  {
   "id": "pack:saint-louis-zoo",
   "name": "Saint Louis Zoo",
   "lat": 38.635173,
   "lon": -90.290909,
   "glow": true,
   "summary": "The free zoo in Forest Park with the 1904 Flight Cage and a miniature railroad. Its chimpanzee show is famous."
  },
