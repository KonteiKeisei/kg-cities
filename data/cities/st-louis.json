  {
   "id": "pack:missouri-botanical-garden",
   "name": "Missouri Botanical Garden",
   "lat": 38.613395,
   "lon": -90.259383,
   "glow": true,
   "summary": "Henry Shaw's garden of 1859, with the geodesic Climatron greenhouse and the largest Japanese garden in North America. The lanterns glow on summer nights."
  },
  {
   "id": "pack:soulard-market",
   "name": "Soulard Market",
   "lat": 38.6105,
   "lon": -90.212,
   "glow": true,
   "summary": "The 1779 farmers' market of the French and German neighbourhood south of downtown. Mardi Gras here is the second biggest in the country."
  },
  {
   "id": "pack:lacledes-landing",
   "name": "Laclede's Landing",
   "lat": 38.630442,
   "lon": -90.184152,
   "glow": true,
   "summary": "Nine blocks of cobbled streets and cast-iron warehouses beside the Eads Bridge, reborn as bars and restaurants. The only part of old riverfront St. Louis to survive the Arch."
  },
  {
   "id": "pack:ss-admiral",
   "name": "SS Admiral",
   "lat": 38.6262,
   "lon": -90.1855,
   "glow": true,
   "summary": "The streamlined Art Deco excursion boat moored on the levee, a fixture of the riverfront since 1940. Its dances and cruises are fading, and its future is uncertain."
  },
