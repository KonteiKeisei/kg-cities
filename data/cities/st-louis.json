  {
   "id": "pack:gateway-arch",
   "name": "Gateway Arch",
   "lat": 38.624507,
   "lon": -90.185683,
   "glow": true,
   "summary": "Eero Saarinen's 630-foot stainless steel arch on the riverfront, the Gateway to the West. Egg-shaped tram cars ride up inside each leg to a window at the top."
  },
  {
   "id": "pack:busch-stadium",
   "name": "Busch Stadium",
   "lat": 38.6226,
   "lon": -90.1928,
   "glow": true,
   "summary": "The round downtown stadium of the Cardinals and the football Cardinals, its rim lined with arches echoing the Gateway. Whitey Herzog's speedsters win on the artificial turf.",
   "from": 1966,
   "until": 2005
  },
  {
   "id": "pack:anheuser-busch-brewery",
   "name": "Anheuser-Busch Brewery",
   "lat": 38.596377,
   "lon": -90.210294,
   "glow": true,
   "summary": "The largest brewery in the world in Soulard, with the Clydesdales in their Victorian stable. The free tour ends in the hospitality room."
  },
  {
   "id": "pack:union-station",
   "name": "Union Station",
   "lat": 38.628122,
   "lon": -90.208026,
   "glow": true,
   "summary": "The great Romanesque station, once the busiest in the world, reopened last year as a hotel and shopping mall. Its Grand Hall's whispering arch still works.",
